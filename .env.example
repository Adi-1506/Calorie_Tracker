# Copy to .env.local for local development. Never commit real values.
# In Vercel, set these under Settings → Environment Variables, with different
# values for Preview and Production.

# --- Public (shipped to the browser; safe to expose) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=
# 32-byte base64 key for encrypting weight and measurements: openssl rand -base64 32
HEALTH_DATA_ENCRYPTION_KEY=
TURNSTILE_SECRET_KEY=
USDA_API_KEY=
AI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
